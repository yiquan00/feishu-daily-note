<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Minimal Bar: Date & Time on left, Random & Add on right (无App标题，无【已同步】，无标签) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 纯粹的日期时间戳 -->
        <TextView
            android:id="@+id/widget_entry_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="10月26日 周一 15:30"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <!-- 隐藏保留视图（保证向后兼容性与测试用例稳定，不在界面呈现） -->
        <TextView
            android:id="@+id/widget_tag_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_entry_sync_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_entry_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- 🎲 随机换一篇按钮 -->
        <ImageButton
            android:id="@+id/widget_btn_random"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_card_background"
            android:contentDescription="随机换一篇"
            android:padding="5dp"
            android:src="@drawable/ic_shuffle_24" />

        <!-- + 快捷写日记按钮 -->
        <ImageButton
            android:id="@+id/widget_btn_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_icon_button_bg"
            android:contentDescription="写日记"
            android:padding="5dp"
            android:src="@drawable/ic_add_24" />
    </LinearLayout>

    <!-- 纤细分割线 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_border" />

    <!-- Pure Diary Entry Area (大面积留给正文，字号加大约4个号，更加清晰易读) -->
    <LinearLayout
        android:id="@+id/widget_entry_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Pure Diary Text Snippet (在原有基础上增加 4sp，呈现为 17.5sp 大字号) -->
        <TextView
            android:id="@+id/widget_entry_snippet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingExtra="4.5dp"
            android:maxLines="16"
            android:text="记录当下的故事、思考与日常生活点滴..."
            android:textColor="@color/widget_text_primary"
            android:textSize="17.5sp" />
    </LinearLayout>

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/widget_empty_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无日记记录"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="点击快捷开始记录"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
